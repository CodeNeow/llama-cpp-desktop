<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher-icon background: the 135-degree brand gradient
     (top-left #6366F1 to bottom-right #A855F7, matching the SVG source's
     x1/y1=0 x2/y2=1 linearGradient). Android gradient angles run
     counter-clockwise from the +x axis, so visual 135deg = angle 315. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#6366F1"
        android:endColor="#A855F7" />
</shape>
